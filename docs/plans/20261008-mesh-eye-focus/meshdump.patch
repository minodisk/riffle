+/// Scratch: one JSON line per faced file with the features the mesh-eye-focus
+/// Step 2 fit needs (baseline window, AF point, pose, and each eye's contour
+/// region at several margins and iris region), at full precision.
+fn meshdump(dirs: &[PathBuf]) -> Result<()> {
+    const MARGINS: [f32; 4] = [0.0, 0.25, 0.5, 1.0];
+    let mut paths: Vec<PathBuf> = Vec::new();
+    for dir in dirs {
+        let mut found: Vec<PathBuf> = std::fs::read_dir(dir)?
+            .filter_map(|e| e.ok().map(|e| e.path()))
+            .filter(|p| scan::is_raw_file(p))
+            .collect();
+        found.sort();
+        paths.extend(found);
+    }
+    let region = |points: &[[f32; 2]], indices: &[usize], width: usize, height: usize, m: f32| {
+        let (mut x0, mut y0) = (f32::INFINITY, f32::INFINITY);
+        let (mut x1, mut y1) = (f32::NEG_INFINITY, f32::NEG_INFINITY);
+        for &i in indices {
+            let [x, y] = *points.get(i)?;
+            if !x.is_finite() || !y.is_finite() {
+                return None;
+            }
+            (x0, y0, x1, y1) = (x0.min(x), y0.min(y), x1.max(x), y1.max(y));
+        }
+        let margin = (x1 - x0).max(y1 - y0) * m;
+        let lo = |v: f32| (v - margin).floor().max(0.0) as usize;
+        let hi = |v: f32, limit: usize| ((v + margin).ceil().max(0.0) as usize).min(limit);
+        let (left, top) = (lo(x0), lo(y0));
+        let (right, bottom) = (hi(x1, width), hi(y1, height));
+        let w = sharpness::Window {
+            x: left,
+            y: top,
+            width: right.saturating_sub(left),
+            height: bottom.saturating_sub(top),
+        };
+        Some(((w.width >= 3 && w.height >= 3).then_some(w), ((x0 + x1) / 2.0, (y0 + y1) / 2.0)))
+    };
+    let lines: Vec<Option<String>> = {
+        use rayon::prelude::*;
+        paths
+            .par_iter()
+            .map(|p| {
+                let cue = scan::extract_analysis(p).ok()?.cue;
+                let face = cue.face?;
+                let point = cue.detection.as_ref().and_then(|d| d.point);
+                let flag = std::fs::read(xmp::sidecar_path(p))
+                    .ok()
+                    .and_then(|b| xmp::read_flag(&b).ok())
+                    .filter(|f| *f != Flag::None);
+                let (a, jpeg) = reader::read_preview(p).ok()?;
+                let (rgb, w, h) = decode_rgb(&jpeg).ok()?;
+                let gray = candidate::luma(&rgb, w, h);
+                let base = candidate::eye_focus(&gray, w, h, &face);
+                let win = candidate::eye_window(w, h, &face);
+                let mesh = eyes::mesh_of(&rgb, w, h, a.orientation, &face);
+                let num = |v: Option<f64>| v.map_or("null".to_string(), |v| format!("{v:?}"));
+                let meas = |win: Option<sharpness::Window>| {
+                    win.map_or("null".to_string(), |win| {
+                        let (lap, edge, _) = candidate::eye_measures(&gray, w, win);
+                        format!(
+                            "{{\"w\":{},\"h\":{},\"lap\":{:?},\"edge\":{}}}",
+                            win.width,
+                            win.height,
+                            lap,
+                            num(edge)
+                        )
+                    })
+                };
+                let eye = |contour: &[usize], iris: &[usize]| {
+                    let Some(m) = mesh.as_ref() else {
+                        return "null".to_string();
+                    };
+                    let center = region(&m.points, contour, w, h, 0.0).map(|r| r.1);
+                    let contours: Vec<String> = MARGINS
+                        .iter()
+                        .map(|&mg| meas(region(&m.points, contour, w, h, mg).and_then(|r| r.0)))
+                        .collect();
+                    let irises: Vec<String> = MARGINS
+                        .iter()
+                        .map(|&mg| meas(region(&m.points, iris, w, h, mg).and_then(|r| r.0)))
+                        .collect();
+                    format!(
+                        "{{\"center\":{},\"contour\":[{}],\"iris\":[{}]}}",
+                        center.map_or("null".to_string(), |(x, y)| format!("[{x:?},{y:?}]")),
+                        contours.join(","),
+                        irises.join(",")
+                    )
+                };
+                let pose = mesh.as_ref().and_then(|m| m.pose);
+                Some(format!(
+                    "{{\"name\":\"{}\",\"flag\":{},\"state\":\"{:?}\",\"p\":{},\"side\":{:?},\"base\":{{\"window\":{},\"lap\":{:?},\"edge\":{}}},\"af\":{},\"mesh\":{},\"pose\":{},\"left\":{},\"right\":{}}}",
+                    p.file_name().unwrap_or_default().to_string_lossy(),
+                    flag.map_or("null".to_string(), |f| format!("\"{f:?}\"")),
+                    cue.state,
+                    num(cue.eye_focus),
+                    face.width.max(face.height),
+                    win.width,
+                    base.lap,
+                    num(base.edge_width),
+                    point.map_or("null".to_string(), |(x, y)| format!("[{x},{y}]")),
+                    mesh.is_some(),
+                    pose.map_or("null".to_string(), |p| format!(
+                        "{{\"yaw\":{:?},\"pitch\":{:?},\"roll\":{:?}}}",
+                        p.yaw, p.pitch, p.roll
+                    )),
+                    eye(&eyes::LEFT_EYE_CONTOUR, &eyes::LEFT_IRIS),
+                    eye(&eyes::RIGHT_EYE_CONTOUR, &eyes::RIGHT_IRIS)
+                ))
+            })
+            .collect()
+    };
+    for l in lines.into_iter().flatten() {
+        println!("{l}");
+    }
+    Ok(())
+}
