+/// Scratch: one JSON line per faced file with the features the mesh-eye-mask
+/// Step 2 fit needs (baseline window, AF point, pose, and per eye the current
+/// 0.5-margin rectangle and the contour mask at several dilations), at full
+/// precision. `us` is the time of the mask raster and masked measures.
+fn maskdump(dirs: &[PathBuf], threads: usize) -> Result<()> {
+    const DILATIONS: [f32; 5] = [0.0, 0.1, 0.25, 0.5, 1.0];
+    let mut paths: Vec<PathBuf> = Vec::new();
+    for dir in dirs {
+        let mut found: Vec<PathBuf> = std::fs::read_dir(dir)?
+            .filter_map(|e| e.ok().map(|e| e.path()))
+            .filter(|p| scan::is_raw_file(p))
+            .collect();
+        found.sort();
+        paths.extend(found);
+    }
+    let pool = rayon::ThreadPoolBuilder::new()
+        .num_threads(threads)
+        .build()?;
+    let lines: Vec<Option<String>> = pool.install(|| {
+        use rayon::prelude::*;
+        paths
+            .par_iter()
+            .map(|p| {
+                let cue = scan::extract_analysis(p).ok()?.cue;
+                let face = cue.face?;
+                let point = cue.detection.as_ref().and_then(|d| d.point);
+                let flag = std::fs::read(xmp::sidecar_path(p))
+                    .ok()
+                    .and_then(|b| xmp::read_flag(&b).ok())
+                    .filter(|f| *f != Flag::None);
+                let (a, jpeg) = reader::read_preview(p).ok()?;
+                let (rgb, w, h) = decode_rgb(&jpeg).ok()?;
+                let gray = candidate::luma(&rgb, w, h);
+                let win = candidate::eye_window(w, h, &face);
+                let base_lap = sharpness::laplacian_variance(&gray, w, win);
+                let base_edge = candidate::edge_width(&gray, w, win);
+                let mesh = candidate::meshes_face(&face)
+                    .then(|| eyes::mesh_of(&rgb, w, h, a.orientation, &face))
+                    .flatten();
+                let num = |v: Option<f64>| v.map_or("null".to_string(), |v| format!("{v:?}"));
+                let win_json = |win: sharpness::Window| {
+                    format!("[{},{},{},{}]", win.x, win.y, win.width, win.height)
+                };
+                let eye = |contour: &[usize]| {
+                    let Some(m) = mesh.as_ref() else {
+                        return "null".to_string();
+                    };
+                    let rect = candidate::eye_region(&m.points, contour, w, h).map_or(
+                        "null".to_string(),
+                        |win| {
+                            let (lap, edge, _) = candidate::eye_measures(&gray, w, win);
+                            format!(
+                                "{{\"window\":{},\"lap\":{:?},\"edge\":{}}}",
+                                win_json(win),
+                                lap,
+                                num(edge)
+                            )
+                        },
+                    );
+                    let masks: Vec<String> = DILATIONS
+                        .iter()
+                        .map(|&d| {
+                            let t = Instant::now();
+                            let mask = candidate::eye_mask(&m.points, contour, w, h, d);
+                            let measures =
+                                mask.as_ref().map(|mk| candidate::masked_eye_measures(&gray, w, mk));
+                            let us = t.elapsed().as_secs_f64() * 1e6;
+                            match (mask, measures) {
+                                (Some(mk), Some((lap, edge, _))) => format!(
+                                    "{{\"d\":{d:?},\"window\":{},\"pixels\":{},\"lap\":{:?},\"edge\":{},\"rect_edge\":{},\"us\":{us:?}}}",
+                                    win_json(mk.window),
+                                    mk.pixels(),
+                                    lap,
+                                    num(edge),
+                                    num(candidate::edge_width(&gray, w, mk.window))
+                                ),
+                                _ => format!("{{\"d\":{d:?},\"window\":null,\"us\":{us:?}}}"),
+                            }
+                        })
+                        .collect();
+                    format!("{{\"rect\":{},\"mask\":[{}]}}", rect, masks.join(","))
+                };
+                let pose = mesh.as_ref().and_then(|m| m.pose);
+                Some(format!(
+                    "{{\"name\":\"{}\",\"flag\":{},\"state\":\"{:?}\",\"p\":{},\"side\":{:?},\"base\":{{\"window\":{},\"lap\":{:?},\"edge\":{}}},\"af\":{},\"mesh\":{},\"pose\":{},\"left\":{},\"right\":{}}}",
+                    p.file_name().unwrap_or_default().to_string_lossy(),
+                    flag.map_or("null".to_string(), |f| format!("\"{f:?}\"")),
+                    cue.state,
+                    num(cue.eye_focus),
+                    face.width.max(face.height),
+                    win.width,
+                    base_lap,
+                    num(base_edge),
+                    point.map_or("null".to_string(), |(x, y)| format!("[{x},{y}]")),
+                    mesh.is_some(),
+                    pose.map_or("null".to_string(), |p| format!(
+                        "{{\"yaw\":{:?},\"pitch\":{:?},\"roll\":{:?}}}",
+                        p.yaw, p.pitch, p.roll
+                    )),
+                    eye(&eyes::LEFT_EYE_CONTOUR),
+                    eye(&eyes::RIGHT_EYE_CONTOUR)
+                ))
+            })
+            .collect()
+    });
+    for l in lines.into_iter().flatten() {
+        println!("{l}");
+    }
+    Ok(())
+}
