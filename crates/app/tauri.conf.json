{
  "$schema": "../../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Riffle",
  "version": "0.1.0",
  "identifier": "com.minodisk.riffle",
  "build": {
    "frontendDist": "ui",
    "beforeDevCommand": "pnpm exec tsc --watch --preserveWatchOutput -p crates/app/ui/tsconfig.json",
    "beforeBuildCommand": "pnpm exec tsc -p crates/app/ui/tsconfig.json"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Riffle",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
