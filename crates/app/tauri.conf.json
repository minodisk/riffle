{
  "$schema": "../../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Handpic",
  "version": "2.0.0",
  "identifier": "dev.minodisk.handpic",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "ui/dist",
    "beforeDevCommand": "pnpm vp dev",
    "beforeBuildCommand": "pnpm vp build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Handpic",
        "width": 1280,
        "height": 800,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "nsis/hooks.nsh"
      },
      "wix": {
        "upgradeCode": "15df1a23-08b6-56be-b9df-b38d92f7dd75"
      }
    },
    "linux": {
      "deb": {
        "replaces": [
          "riffle"
        ],
        "conflicts": [
          "riffle"
        ]
      },
      "rpm": {
        "obsoletes": [
          "riffle"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2MUFERThGN0EzNDM2RTMKUldUak5qUjZqOTRhSm0xQ0RwOUJvSjBIUmhmbkFvdU93SWlqNkRWTmIyQktheFNZS2ZERzZiWnQK",
      "endpoints": [
        "https://github.com/minodisk/handpic/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
